# Optional: swap the tile provider later without code changes.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=19

# Optional: use a self-hosted or dedicated Nominatim-compatible geocoder later.
NEXT_PUBLIC_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search

# Optional but recommended by Nominatim for identifying your app's public API usage.
NEXT_PUBLIC_NOMINATIM_EMAIL=
